# Copy to .env and fill in what you like. Anything entered on the dashboard's
# Settings page is stored in the database and takes precedence over this file.

# --- Telnyx (required to place real calls) ---------------------------------
# API key: Telnyx portal -> API Keys -> Create API Key.
TELNYX_API_KEY=
# TeXML application: Telnyx portal -> Voice -> TeXML Applications.
# This is what actually originates the call, and it needs an outbound voice
# profile attached to it before Telnyx will let it dial.
TELNYX_TEXML_APP_ID=
# The voice-capable Telnyx number you bought. This is the caller ID recipients
# see, and it must be assigned to the TeXML application above. Telnyx has no
# "verified caller ID" shortcut - you have to own the number.
TELNYX_FROM_NUMBER=
# Optional, webhook mode only: Telnyx portal -> Account Settings -> Keys &
# Credentials -> Public Key. Set this and the server will verify the Ed25519
# signature on every incoming webhook instead of trusting the call token alone.
TELNYX_PUBLIC_KEY=

# --- Testing ----------------------------------------------------------------
# Your own mobile. Every call costs real money against the Telnyx balance.
TEST_DESTINATION_NUMBER=

# --- Caller identity (prepended/appended to every script) -------------------
BUSINESS_NAME=
CALLBACK_NUMBER=

# --- Calling rules ----------------------------------------------------------
# Local time at the RECIPIENT, derived from their area code. The federal TCPA
# limit is 08:00-21:00; several states are stricter, so the default is tighter.
CALLING_WINDOW_START=
CALLING_WINDOW_END=
CALLS_PER_MINUTE=
RING_SECONDS=

# --- Optional: webhook mode -------------------------------------------------
# Leave blank for direct mode (nothing needs to be reachable from the internet).
# Set to a public HTTPS URL for this server - e.g. an ngrok tunnel - to enable
# press-9-to-opt-out, hanging up on voicemail, and live status callbacks.
# PUBLIC_BASE_URL=https://your-tunnel.ngrok-free.app

# --- Optional: AI script writer ---------------------------------------------
# Either key powers "Draft with AI". SCRIPT_PROVIDER picks one when both are set
# (anthropic | perplexity; blank = whichever key exists, Anthropic first).
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
# SCRIPT_PROVIDER=
# PERPLEXITY_MODEL=anthropic/claude-opus-5-5

# --- Optional: AI phone agent ("AI conversation" calls) ----------------------
# Telnyx runs the call and asks this server's /llm/v1 endpoint what to say; the
# server answers via Perplexity's Agent API. Needs PERPLEXITY_API_KEY and
# PUBLIC_BASE_URL too. AGENT_PROXY_TOKEN is any long random string - Telnyx stores
# it and sends it back on every request. Then press Settings > AI phone agent >
# "Set up in Telnyx", which fills in TELNYX_ASSISTANT_ID for you.
AGENT_PROXY_TOKEN=
# AGENT_MODEL=anthropic/claude-haiku-4-5
# AGENT_VOICE=Telnyx.KokoroTTS.af_heart
# TELNYX_ASSISTANT_ID=

# --- Optional: database location --------------------------------------------
# Defaults to %LOCALAPPDATA%\RoboCallAI\robocall.db - deliberately OUTSIDE this
# Dropbox folder, because Dropbox replaces synced files under a running app and
# destroys an open SQLite database. Only move this to another NON-synced path.
# ROBOCALL_DB=

# --- Optional: Postgres instead of SQLite -----------------------------------
# Set to use Postgres (e.g. Supabase's session pooler URL, port 5432) and
# ROBOCALL_DB is ignored. ROBOCALL_PG_SCHEMA puts the tables in their own schema
# instead of `public`.
# DATABASE_URL=postgresql://user:password@host:5432/postgres?sslmode=require
# ROBOCALL_PG_SCHEMA=
